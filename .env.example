# ЗАГЛУШКА: используйте тестовые shopId и секретный ключ из тестового магазина ЮKassa.
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ЗАГЛУШКА: после согласования услуги укажите её точное название и сумму (в копейках).
# Не используйте цену «от» из каталога сайта.
YOOKASSA_ITEM_NAME=
YOOKASSA_AMOUNT_KOPEKS=

# URL сайта без завершающего пути. Для локального Netlify Dev можно использовать http://localhost:8888.
SITE_URL=https://stvnislv.netlify.app

# Токен бота @stvnislv_bot из @BotFather — для scripts/setup-telegram-bot.mjs. Не коммитить.
TELEGRAM_BOT_TOKEN=

# Числовой Telegram ID владельца: только он видит админку и управляет заявками.
OWNER_TELEGRAM_ID=288440954
# Секрет webhook бота: 32+ символа латиницы, цифр, «-» и «_». Сгенерировать: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
TELEGRAM_WEBHOOK_SECRET=
# Адреса, с которых сайт и Mini App обращаются к API (через запятую, без пути).
ALLOWED_ORIGINS=https://stvnislv.netlify.app,https://stvnislv-app.netlify.app
# Соль для хэша IP в ограничении числа заявок. Сгенерировать так же, как секрет.
IP_HASH_SALT=

# Хранилище: supabase (по умолчанию); file — JSON-файлы в STORAGE_DIR (для VPS); blobs — Netlify Blobs; memory — только тесты.
STORAGE_DRIVER=supabase
# Supabase: адрес проекта и СЕКРЕТНЫЙ ключ (Project Settings → API Keys: sb_secret_… или service_role).
# Публичный sb_publishable_… не подходит. Таблица — supabase/schema.sql.
SUPABASE_URL=https://isbwhkbliietwvgpofip.supabase.co
SUPABASE_SECRET_KEY=
# Абсолютный путь к папке данных для STORAGE_DRIVER=file, например /var/lib/stvnislv.
STORAGE_DIR=

# --- server/server.mjs: проверка на Mac и будущий VPS (на Netlify не нужно) ---
# На VPS: STORAGE_DRIVER=file и STORAGE_DIR=/var/lib/stvnislv (см. выше).
# Порт и адрес, на которых слушает сервер; снаружи к нему ходит только Caddy.
PORT=3000
HOST=127.0.0.1
# 1 — сервер стоит за Caddy: IP клиента берётся из X-Forwarded-For. На Mac без Caddy — не задавать.
TRUST_PROXY=
# Для проверки на Mac: сервер сам отдаёт сайт и tg-app из этой папки (STATIC_ROOT=.). На VPS статику отдаёт Caddy.
STATIC_ROOT=
# Username бота без @ — для ссылки «Получать ответ в Telegram».
TELEGRAM_BOT_USERNAME=stvnislv_bot
