# ЗАГЛУШКА: используйте тестовые shopId и секретный ключ из тестового магазина ЮKassa.
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ЗАГЛУШКА: после согласования услуги укажите её точное название и сумму (в копейках).
# Не используйте цену «от» из каталога сайта.
YOOKASSA_ITEM_NAME=
YOOKASSA_AMOUNT_KOPEKS=

# URL сайта без завершающего пути. Для локального Netlify Dev можно использовать http://localhost:8888.
SITE_URL=https://stvnislv.netlify.app

# Токен бота @stvnislv_bot из @BotFather — для scripts/setup-telegram-bot.mjs. Не коммитить.
TELEGRAM_BOT_TOKEN=

# Числовой Telegram ID владельца: только он видит админку и управляет заявками.
OWNER_TELEGRAM_ID=288440954
# Секрет webhook бота: 32+ символа латиницы, цифр, «-» и «_». Сгенерировать: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
TELEGRAM_WEBHOOK_SECRET=
# Адреса, с которых сайт и Mini App обращаются к API (через запятую, без пути).
ALLOWED_ORIGINS=https://stvnislv.netlify.app,https://stvnislv-app.netlify.app
# Соль для хэша IP в ограничении числа заявок. Сгенерировать так же, как секрет.
IP_HASH_SALT=

# Хранилище: blobs — Netlify Blobs (по умолчанию); file — JSON-файлы в STORAGE_DIR (для VPS); memory — только тесты.
STORAGE_DRIVER=blobs
# Абсолютный путь к папке данных для STORAGE_DRIVER=file, например /var/lib/stvnislv.
STORAGE_DIR=
