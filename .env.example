# ЗАГЛУШКА: используйте тестовые shopId и секретный ключ из тестового магазина ЮKassa.
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ЗАГЛУШКА: после согласования услуги укажите её точное название и сумму (в копейках).
# Не используйте цену «от» из каталога сайта.
YOOKASSA_ITEM_NAME=
YOOKASSA_AMOUNT_KOPEKS=

# URL сайта без завершающего пути. Для локального Netlify Dev можно использовать http://localhost:8888.
SITE_URL=https://stvnislv.netlify.app

# Токен бота @stvnislv_bot из @BotFather — для scripts/setup-telegram-bot.mjs. Не коммитить.
TELEGRAM_BOT_TOKEN=
